#!/bin/sh
# aienos -- the front door to the AIEN tree.
#
# Every component is linked in as a git submodule pinned at one commit, so
# a checkout of this repository names exactly which version of each part
# belongs together.
#
#   ./aienos get              fetch every component at its pinned commit
#   ./aienos status           each component: pinned commit, its main, current or behind
#   ./aienos bump [path...]   move pins to each component's main (all if none named);
#                             stages the change for a pull request, commits nothing
#
# Needs: POSIX sh, git. Network only for get, status and bump.
set -eu
cd "$(dirname "$0")"

paths() { git config -f .gitmodules --get-regexp '^submodule\..*\.path$' | awk '{print $2}'; }
url_of() { git config -f .gitmodules --get "submodule.$1.url"; }
pin_of() { git ls-files -s -- "$1" | awk '{print $2}'; }
main_of() { git ls-remote "$(url_of "$1")" refs/heads/main | awk '{print $1}'; }
short() { printf '%.10s' "$1"; }

cmd=${1:-help}
[ $# -gt 0 ] && shift
case "$cmd" in
get)
    git submodule sync -q
    git submodule update --init --depth 1 --recommend-shallow
    echo "aienos: $(paths | wc -l | tr -d ' ') components at their pinned commits"
    ;;
status)
    behind=0
    for p in $(paths); do
        pin=$(pin_of "$p")
        main=$(main_of "$p")
        if [ -z "$main" ]; then
            printf '%-28s pinned %s  main: unreachable\n' "$p" "$(short "$pin")"
            behind=$((behind + 1))
        elif [ "$pin" = "$main" ]; then
            printf '%-28s pinned %s  current\n' "$p" "$(short "$pin")"
        else
            printf '%-28s pinned %s  main %s  behind\n' "$p" "$(short "$pin")" "$(short "$main")"
            behind=$((behind + 1))
        fi
    done
    echo "aienos: $behind behind"
    [ "$behind" -eq 0 ]
    ;;
bump)
    list=${*:-$(paths)}
    moved=0
    for p in $list; do
        paths | grep -qx "$p" || { echo "aienos: no component at $p" >&2; exit 2; }
        main=$(main_of "$p")
        [ -n "$main" ] || { echo "aienos: $p: main unreachable" >&2; exit 1; }
        [ "$(pin_of "$p")" = "$main" ] && continue
        git submodule update --init --depth 1 -- "$p" >/dev/null
        git -C "$p" fetch -q --depth 1 origin "$main"
        git -C "$p" checkout -q --detach "$main"
        git add -- "$p"
        echo "aienos: $p -> $(short "$main")"
        moved=$((moved + 1))
    done
    echo "aienos: $moved moved (staged; commit on a branch and open a pull request)"
    ;;
*)
    sed -n '2,15s/^# \{0,1\}//p' "$0"
    ;;
esac
